# ===== EdgeSeg-EfficientViT phase1 (baseline & profiling) =====
# 大体积权重 / 数据 / Nsight 报告不入库，仅保留脚本、文档与小型指标 JSON/MD
phase1/weights/*
!phase1/weights/.gitkeep
phase1/data/*
!phase1/data/.gitkeep
!phase1/data/city_asset_cityscapes_like.png
phase1/results/nsight/*
!phase1/results/nsight/.gitkeep

# Nsight 报告与中间文件
*.nsys-rep
*.qdrep
*.sqlite
*.qdstrm

# 模型与权重通用后缀
*.pt
*.pth
*.onnx
*.engine
*.plan
*.trt

# ===== EdgeSeg-EfficientViT phase3 (TensorRT Plugin, C++/CUDA) =====
# 跟进 PROJECT_STRATEGY.md V3.1：阶段三新增自定义算子开发，预排编译产物
# 构建目录（CMake / Make / Ninja 通用）
phase3/build/
phase3/*/build/
build/
out/
cmake-build-*/

# 本地 tensor 捕获包通常较大，只保留目录占位与 JSON/MD 结论入库
phase3/results/tensors/*
!phase3/results/tensors/.gitkeep

# 目标文件与中间产物
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exp
*.ilk

# CUDA 编译产物
*.cubin
*.fatbin
*.ptx
*.gpu

# IDE / 编译数据库
compile_commands.json
.cache/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# Windows MSVC 调试产物
*.pdb
*.idb
*.suo
